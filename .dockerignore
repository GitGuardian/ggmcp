# Send only the files required by Dockerfile COPY instructions.
# Root-level local configuration, reports, and tooling stay outside the context.
**
!pyproject.toml
!uv.lock
!README.md
!src/
src/*
!src/gg_api_core/
!src/gg_api_core/**
!src/gg_mcp_server/
!src/gg_mcp_server/**

# Keep generated files and local configuration out of the source trees too.
**/__pycache__/
**/*.py[cod]
**/*.so
**/*.egg-info/
**/.env*
**/.git/
**/.venv/
**/.claude/
**/.pi/
**/.build/
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/.idea/
**/.vscode/
**/.DS_Store
**/*.log
**/*.sqlite
**/*.db
**/*.swp
**/*.swo
**/*~
